# Application
APP_NAME=AUGSD Portal
DEBUG=True

# Database
# Default local setup:
# - `docker compose up -d db`
# - database available at localhost:5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/portal_global
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portal_global
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security
# Replace this in any shared or production environment.
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Files
UPLOAD_DIR=uploads
EXPORT_DIR=exports
MAX_UPLOAD_SIZE=52428800

# Optional bootstrap users.
# Leave empty for normal local development.
# Example format depends on the user-management script used in your setup.
DEFAULT_USERS=
